<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <body>
    <div class="container">
      <div class="content">
        <!--Fazendo looping-->
        <%if (users.length > 0) { %> <% users.forEach(user => {%> 
        <h3 class="title">
          <%= user.firstName %> <%=user.lastName %>
        </h3>

        <p><%=user.email%></p>

      <!-- Tag do for each--><%})%>  <!--Tag do if--><%} else {%>
        <p>não há usuários para exibir...</p>
        <%}%>

        <!--Somente uma linha js para cada-->
      </div>
    </div>
  </body>
</html>
